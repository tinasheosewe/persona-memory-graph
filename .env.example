# Port for the Docker image and scripts/run_api.sh. The compose file publishes 8000.
PORT=8000
# Inside docker compose the Postgres host is "db"; for a local run use localhost.
DATABASE_URL=postgresql+psycopg2://kg:kgpass@db:5432/kg

# LLM settings. Leave OPENAI_API_KEY empty to use the mock extractor (no LLM calls).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_WALK_MODEL=gpt-4o-mini
DEMO_LLM_MODEL=gpt-4o-mini

# Neo4j (optional). Uncomment when the neo4j compose profile or your own instance is running.
# NEO4J_URI=neo4j://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=kgneo4jpass
